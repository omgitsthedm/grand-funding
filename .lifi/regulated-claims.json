  "rules": [
    {
      "id": "occupancy-and-consumer-purpose",
      "label": "Owner occupancy, primary residence, and consumer-purpose eligibility",
      "pattern": "\\b(?:owner[- ]occupied|primary residence(?:s)?|consumer[- ]purpose)\\b",
      "flags": "gi"
    },
    {
      "id": "rates-and-points",
      "label": "Advertised rates, APR, and origination points",
      "pattern": "(?:\\b(?:interest rates?|rates?|APR|origination (?:fees?|points?)|points?|interestRate)\\b.{0,30}?\\d{1,3}(?:\\.\\d+)?(?:\\s*(?:-|–|—|to)\\s*\\d{1,3}(?:\\.\\d+)?)?\\s*%|\\d{1,3}(?:\\.\\d+)?(?:\\s*(?:-|–|—|to)\\s*\\d{1,3}(?:\\.\\d+)?)?\\s*%.{0,30}?\\b(?:interest rates?|rates?|APR|origination (?:fees?|points?)|points?)\\b|\\b\\d+(?:\\.\\d+)?(?:\\s*(?:-|–|—|to)\\s*\\d+(?:\\.\\d+)?)?\\s+(?:origination )?points?\\b)",
      "flags": "gi"
    },
    {
      "id": "loan-amounts",
      "label": "Advertised loan minimums, maximums, ranges, and financing amounts",
      "pattern": "(?:\"(?:minValue|maxValue)\"\\s*:\\s*\\d+|\\b(?:loan amounts?|loan range|financing|minimum|maximum|up to|borrow|fund)\\b.{0,30}?\\$[\\d,.]+(?:\\s*(?:-|–|—|to)\\s*\\$?[\\d,.]+)?\\s*(?:[KkMm]\\+?|million|thousand)?|\\$[\\d,.]+(?:\\s*(?:-|–|—|to)\\s*\\$?[\\d,.]+)?\\s*(?:[KkMm]\\+?|million|thousand)?.{0,30}?\\b(?:loan amounts?|loan range|financing|minimum|maximum|borrow)\\b|\\$[\\d,.]+(?:\\s*(?:-|–|—|to)\\s*\\$?[\\d,.]+)?\\s*(?:[KkMm]\\+?|million|thousand)?\\s*(?:loan|ceiling|cap)\\b)",
      "flags": "gi"
    },
    {
      "id": "leverage",
      "label": "Advertised LTV, ARV, LTC, CLTV, and financed-cost limits",
      "pattern": "(?:\\b(?:LTV|ARV|LTC|CLTV)\\b.{0,35}?\\d{1,3}(?:\\.\\d+)?(?:\\s*(?:-|–|—|to)\\s*\\d{1,3}(?:\\.\\d+)?)?\\s*%|\\d{1,3}(?:\\.\\d+)?(?:\\s*(?:-|–|—|to)\\s*\\d{1,3}(?:\\.\\d+)?)?\\s*%\\s*(?:of\\s+(?:the\\s+)?(?:purchase price|current value|after-repair value|ARV|LTV|LTC|CLTV|project costs?|rehab(?: costs?)?|land value)|(?:LTV|ARV|LTC|CLTV)\\b))",
      "flags": "gi"
    },
    {
      "id": "timing-taxonomy",
      "label": "Approval, decision, term-sheet, closing, funding, and response timing",
      "pattern": "(?:\\b(?:approv(?:e|al|ed|als)|decision|term[ -]sheets?|clos(?:e|es|ing|ed)|fund(?:s|ing|ed)?|turnaround|pre-approv(?:al|ed)|respond|response)\\b[^.!?]{0,30}?\\b(?:same[ -]day|\\d+(?:\\s*(?:-|–|—|to)\\s*\\d+)?(?:\\+)?[ -]?(?:business[ -])?(?:hours?|days?|weeks?))\\b|\\b(?:same[ -]day|\\d+(?:\\s*(?:-|–|—|to)\\s*\\d+)?(?:\\+)?[ -]?(?:business[ -])?(?:hours?|days?|weeks?))\\b[^.!?]{0,30}?\\b(?:approv(?:e|al|ed|als)|decision|term[ -]sheets?|clos(?:e|es|ing|ed)|fund(?:s|ing|ed)?|turnaround|pre-approv(?:al|ed)|respond|response)\\b)",
      "flags": "gi"
    },
    {
      "id": "service-area",
      "label": "Licensed, advertised, and exceptional service-area claims",
      "pattern": "(?:\\bnationwide\\b|\\bstatewide\\b|\\boutside Arizona or California\\b|\\b(?:Arizona|California)\\s*(?:and|or|&)\\s*(?:California|Arizona)\\b|\\b(?:serv(?:e|es|ed|ing)|lend(?:s|ing)?|originate(?:s|d|ing)?|licensed|provid(?:e|es|ing))\\s+[^.!?]{0,35}?\\b(?:Arizona|California|Alabama|Alaska|Arkansas|Colorado|Connecticut|Delaware|Florida|Georgia|Hawaii|Idaho|Illinois|Indiana|Iowa|Kansas|Kentucky|Louisiana|Maine|Maryland|Massachusetts|Michigan|Minnesota|Mississippi|Missouri|Montana|Nebraska|Nevada|New Hampshire|New Jersey|New Mexico|New York|North Carolina|North Dakota|Ohio|Oklahoma|Oregon|Pennsylvania|Rhode Island|South Carolina|South Dakota|Tennessee|Texas|Utah|Vermont|Virginia|Washington|West Virginia|Wisconsin|Wyoming)\\b)",
      "flags": "gi"
    },
    {
      "id": "unverified-volume-and-vanity",
      "label": "Unverified lending volume and self-awarded best-lender claims",
      "pattern": "(?:1,500 loans|\\$350 million|best hard money lender(?:s)?)",
      "flags": "gi"
    }
  ],
